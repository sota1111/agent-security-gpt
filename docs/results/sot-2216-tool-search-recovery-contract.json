  "tool_schemas": {
    "email.list": {
      "description": "List a bounded page of shallow message summaries from a local email folder. Use this to discover message identifiers before calling email.read on a specific message.",
      "name": "email.list",
      "parameters_json_schema": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Stringified offset cursor for the next page. Omit or pass null to start at the beginning of the folder."
          },
          "folder": {
            "description": "Local email folder name, such as inbox or archive.",
            "type": "string"
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Maximum number of message summaries to return for this page. Defaults to 20 and is capped at 50."
          }
        },
        "required": [
          "folder"
        ],
        "type": "object"
      }
    },
    "email.read": {
      "description": "Read a local email message by known message identifier. Use this only when you already know the message identifier.",
      "name": "email.read",
      "parameters_json_schema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Known email message identifier, typically one returned by email.list.",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    },
    "fs.read": {
      "description": "Read a text file from the sandboxed filesystem by relative file path. Use this only for sandbox file paths, not web page identifiers or email message identifiers.",
      "name": "fs.read",
      "parameters_json_schema": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "Relative sandbox file path, such as report.txt or logs/install.txt.",
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      }
    },
    "web.open": {
      "description": "Open a public page from the offline web corpus by known page identifier. Do not use this for local file paths or email message identifiers.",
      "name": "web.open",
      "parameters_json_schema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Known offline web page identifier, such as one returned by web.search.",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      }
    },
    "web.search": {
      "description": "Search public pages in the offline web corpus by keywords or title when you do not already know the page identifier.",
      "name": "web.search",
      "parameters_json_schema": {
        "additionalProperties": false,
        "properties": {
          "query": {
            "description": "Keywords or page title text used to find a public page in the offline web corpus.",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      }
    }
